# Leer los datos
dades <- read.csv("Airbnb_Open_Data.csv")
# Identificar las columnas numéricas
tipos <- sapply(dades, class)
varNum <- names(tipos)[tipos %in% c("integer", "numeric")]
varNum <- varNum[!varNum %in% c("id", "host.id")]
# Seleccionar las columnas numéricas
numericas <- dades[, varNum]
# Manejar valores faltantes en las columnas numéricas (imputar con la media)
numericas <- apply(numericas, 2, function(x) ifelse(is.na(x), mean(x, na.rm = TRUE), x))
# Convertir el resultado nuevamente a matriz (si es necesario)
numericas <- as.matrix(numericas)
# Verificar que las columnas numéricas estén listas para análisis
print(apply(numericas, 2, var))  # Deben tener varianza positiva
# Ahora puedes continuar con el análisis
distances <- dd.plot(numericas, quan = 1/2, alpha = 0.025)
# Ahora puedes continuar con el análisis
distances <- dd.plot(numericas, quan = 1/2, alpha = 0.025)
low_variance <- apply(numericas, 2, var) == 0
print(low_variance)
numericas <- numericas[, !low_variance]
cor_matrix <- cor(numericas)
print(cor_matrix)
# Identificar pares de columnas con correlación excesiva
high_cor <- which(abs(cor_matrix) > 0.95 & lower.tri(cor_matrix), arr.ind = TRUE)
print(high_cor)
# Eliminar columnas redundantes (puedes elegir cuál eliminar)
numericas <- numericas[, -high_cor[, 2]]
# Ahora puedes continuar con el análisis
distances <- dd.plot(numericas, quan = 1/2, alpha = 0.025)
