# 1. Cargar los datos
dades <- read.csv("Airbnb_Open_Data.csv", stringsAsFactors = FALSE)
varNum <- names(tipos)[tipos %in% c("integer", "numeric")]
varNum <- varNum[!varNum %in% c("id", "host.id")]
numericas <- dades[, varNum]
numericas <- as.matrix(numericas)
# 3. Revisar la cantidad de valores únicos por variable
unique_counts <- apply(numericas, 2, function(x) length(unique(x)))
cat("Número de valores únicos por variable:\n")
print(unique_counts)
# 4. Seleccionar variables con al menos 30 niveles para el análisis
vars_to_keep <- names(unique_counts)[unique_counts >= 30]
cat("Variables usadas en el análisis (>= 30 niveles):\n")
print(vars_to_keep)
# Si observas que alguna variable con muchos empates genera problemas (como "calculated.host.listings.count"),
# puedes excluirla de dd.plot. Por ejemplo, si "calculated.host.listings.count" causa problemas:
vars_dd <- setdiff(vars_to_keep, "calculated.host.listings.count")
cat("Variables usadas en dd.plot (excluyendo variables problemáticas):\n")
print(vars_dd)
# 4. Seleccionar variables con al menos 30 niveles para el análisis
vars_to_keep <- names(unique_counts)[unique_counts >= 80]
cat("Variables usadas en el análisis (>= 30 niveles):\n")
print(vars_to_keep)
# 4. Seleccionar variables con al menos 30 niveles para el análisis
vars_dd <- names(unique_counts)[unique_counts >= 30]
cat("Variables usadas en el análisis (>= 30 niveles):\n")
print(vars_dd)
# 5. Filtrar las variables para dd.plot
numericas_filtradas <- numericas[, vars_dd]
# 6. Normalizar (escalar) los datos
Y <- scale(numericas_filtradas)
# 7. Aplicar dd.plot (mvoutlier)
# dd.plot utiliza el método robusto (covMcd) para detectar outliers multivariantes.
# Con datos que tienen muchos empates, se pueden generar errores si hay cero desviación en alguna dimensión.
distances <- dd.plot(Y, quan = 1/2, alpha = 0.025)
