library(readr)
library(mvoutlier)
library(MVN)
library(chemometrics)
library(DMwR2)
library(Rlof)
library(scatterplot3d)
library(plotly)
library(rgl)
library(adamethods)
library(dplyr)
library(ggplot2)
dades <- read.csv("Airbnb_Open_Data.csv", stringsAsFactors = FALSE)
tipos <- sapply(dades, class)
varNum <- names(tipos)[tipos %in% c("integer", "numeric")]
varNum <- varNum[!varNum %in% c("id", "host.id")]
numericas <- dades[, varNum]
numericas <- as.matrix(numericas)
unique_counts <- apply(numericas, 2, function(x) length(unique(x)))
cat("Número de valores únicos por variable:\n")
print(unique_counts)
# 5. Filtrar las variables para dd.plot
numericas_filtradas <- numericas[, !colnames(numericas) %in% c("Construction.year", "review.rate.number", "calculated.host.listings.count", "availability.365")]
# 6. Normalizar (escalar) los datos
Y <- scale(numericas_filtradas)
# 7. Aplicar dd.plot (mvoutlier)
# dd.plot utiliza el método robusto (covMcd) para detectar outliers multivariantes.
# Con datos que tienen muchos empates, se pueden generar errores si hay cero desviación en alguna dimensión.
distances <- dd.plot(Y, quan = 1/2, alpha = 0.025)
# Identificar la columna problemática: probar quitar cada columna y ver si dd.plot se ejecuta sin error
cols <- colnames(Y)
for(i in seq_along(cols)) {
cat("Probando sin la columna:", cols[i], "\n")
Y_subset <- Y[, -i, drop = FALSE]
test_result <- try(dd.plot(Y_subset, quan = 1/2, alpha = 0.025), silent = TRUE)
if(inherits(test_result, "try-error")){
cat("  -> Error al ejecutar dd.plot sin", cols[i], "\n")
} else {
cat("  -> dd.plot funciona sin", cols[i], "\n")
}
}
