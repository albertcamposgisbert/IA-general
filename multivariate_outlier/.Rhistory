library(mvoutlier)
library(MVN)
library(chemometrics)
library(DMwR2)
library(Rlof)
library(scatterplot3d)
library(plotly)
dades <- read.csv("Airbnb_Open_Data.csv")
dades <- read.csv("Airbnb_Open_Data.csv")
varNum <- names(tipos)[tipos %in% c("integer", "numeric")]
varNum <- varNum[!varNum %in% c("id", "host.id")]
numericas <- dades[, varNum]
# Datos cargados y limpieza previa (asegurando que `dades` esté preparado)
numericas <- apply(dades[, varNum], 2, function(x) ifelse(is.na(x), mean(x, na.rm = TRUE), x))
numericas <- as.matrix(numericas)
# ----------------------------------------------
# 1. Detección de outliers con Mahalanobis
distancia_mahalanobis <- mahalanobis(numericas, colMeans(numericas), cov(numericas))
cutoff <- qchisq(p = 0.99, df = ncol(numericas))
outliers_mahalanobis <- numericas[distancia_mahalanobis > cutoff, ]
print("Outliers detectados con Mahalanobis:")
print(outliers_mahalanobis)
# Visualización de densidad
plot(density(distancia_mahalanobis), main = "Densidad de distancias de Mahalanobis")
abline(v = cutoff, col = "red")
# ----------------------------------------------
# 2. Visualización en 3D de los outliers
umbral <- 8
dades[, "outlier"] <- (distancia_mahalanobis > umbral)
dades[, "color"] <- ifelse(dades[, "outlier"], "red", "black")
scatterplot3d(
dades[, "lat"], dades[, "long"], dades[, "minimum.nights"],
color = dades[, "color"], main = "Outliers Mahalanobis"
)
# Visualización con plotly
fig <- plotly::plot_ly(
dades, x = ~lat, y = ~long, z = ~minimum.nights,
color = ~color, colors = c('#0C4B8E', '#BF382A')
) %>% add_markers()
fig
