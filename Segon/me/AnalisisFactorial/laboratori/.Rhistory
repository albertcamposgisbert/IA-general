ggpairs(heptathlon[, -score], progress = FALSE)
heptathlon <- heptathlon[-grep("PNG", rownames(heptathlon)), ]
ggpairs(heptathlon[, -score], progress = FALSE)
hept_def       <- scale(heptathlon[, -score])
heptathlon_pca <- princomp(hept_def)
